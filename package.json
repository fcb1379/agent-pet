{
  "name": "agent-pet",
  "version": "0.5.1",
  "description": "A Windows desktop pet that reflects Codex and Claude Code activity from Windows and WSL.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "prestart": "node scripts/dependency-bootstrap.js",
    "start": "electron .",
    "predev": "node scripts/dependency-bootstrap.js",
    "dev": "electron . --dev",
    "postinstall": "node scripts/dependency-bootstrap.js --stamp",
    "setup": "npm ci --no-audit --no-fund",
    "test": "node --test tests/*.test.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/uninstall-hooks.js",
    "simulate": "node scripts/simulate.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.agentpet.desktop",
    "productName": "Agent Pet",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "bridge/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "AgentPet-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "upng-js": "^2.1.0"
  }
}
