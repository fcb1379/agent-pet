{
  "name": "agent-pet",
  "version": "0.5.7",
  "description": "A desktop pet that reflects Codex and Claude Code activity on Windows, WSL and macOS.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "prestart": "node scripts/dependency-bootstrap.js",
    "start": "electron .",
    "predev": "node scripts/dependency-bootstrap.js",
    "dev": "electron . --dev",
    "postinstall": "node scripts/dependency-bootstrap.js --stamp",
    "setup": "npm ci --no-audit --no-fund",
    "test": "node --test tests/*.test.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/uninstall-hooks.js",
    "simulate": "node scripts/simulate.js",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.agentpet.desktop",
    "productName": "Agent Pet",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/node-win-x64/**/*"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "bridge/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "AgentPet-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "assets/mascot.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "AgentPet-${version}-mac-arm64.${ext}",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Agent Pet ${version}"
    }
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "upng-js": "^2.1.0"
  },
  "optionalDependencies": {
    "node-win-x64": "24.14.0"
  }
}
